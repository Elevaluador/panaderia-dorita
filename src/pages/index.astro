---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import  HeaderLink from '../components/HeaderLink.astro';
import * as Variables from '../consts';
import { Image } from 'astro:assets';
---
<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={Variables.SEO_TITLE} description={Variables.SEO_DESCRIPTION} robots={Variables.robots}/>
	</head>
	<style>
	/* ============ DIVISOR "PAN PARTIDO" ============ */
  .divisor{
    display:block;
    width:100%;
    height:24px;
    margin-top:-1px;
  }
  .divisor--a polygon{ fill: var(--crema-oscura); }
  .divisor--b polygon{ fill: var(--crema); }
  .divisor--c polygon{ fill: var(--marron); }

  /* ============ HERO CON FOTO DE FONDO ============ */
  .hero{
    position: relative;
    overflow:hidden;
    text-align:center;
    color: var(--crema);
  }
  .hero__foto-fondo{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:center;
    z-index:0;
  }
  .hero__velo{
    position:absolute;
    inset:0;
    z-index:1;
    background: linear-gradient(180deg, rgba(43,25,20,0.55) 0%, rgba(43,25,20,0.72) 55%, rgba(30,17,14,0.92) 100%);
  }
  .hero__contenido{
    position:relative;
    z-index:2;
    padding: 56px 0 52px;
  }
  .hero__logo{
    width:120px;
    height:120px;
    border-radius:50%;
    margin: 0 auto 18px;
    border: 3px solid rgba(249,246,238,0.85);
    box-shadow: var(--sombra-fuerte);
  }
  .hero h1{
    color: var(--crema);
    font-size: clamp(2rem, 7vw, 3.4rem);
    font-weight:600;
    max-width: 760px;
    margin: 0 auto;
  }
  .hero__slogan{
    font-family: var(--font-display);
    font-style: italic;
    color: #F0C9AE;
    font-size: 1.05rem;
    margin-top:14px;
  }
  .hero__texto{
    max-width: 560px;
    margin: 18px auto 0;
    font-size: 1.05rem;
    color: rgba(249,246,238,0.88);
  }
  .hero__acciones{
    display:flex;
    flex-direction:column;
    gap:12px;
    align-items:center;
    margin-top: 30px;
  }
  .hero__acciones .boton{ width:100%; max-width:340px;}
  .hero__badges{
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
    gap: 10px 22px;
    margin-top: 30px;
    font-size: 0.82rem;
    color: rgba(249,246,238,0.85);
    font-weight:600;
  }
  .hero__badges li{
    list-style:none;
    display:flex;
    align-items:center;
    gap:7px;
  }
  .hero__badges svg{ width:16px; height:16px; color: #F0C9AE; flex-shrink:0; }

  /* ============ BLOQUES GENERALES ============ */
  .bloque{
    padding: 52px 0;
  }
  .bloque--oscuro{ background: var(--crema-oscura); }
  .bloque--marca{ background: var(--marron); color: var(--crema); }
  .bloque__cabecera{
    max-width: 620px;
    margin: 0 0 34px;
  }
  .bloque__cabecera h2{
    font-size: clamp(1.6rem, 5vw, 2.3rem);
    font-weight:600;
    margin-top:10px;
  }
  .bloque--marca h2{ color: var(--crema); }
  .bloque__cabecera p{
    margin-top:12px;
    color: var(--marron-suave);
    font-size: 1.02rem;
  }
  .bloque--marca .bloque__cabecera p{ color: rgba(249,246,238,0.82); }
  .bloque__cabecera--centro{
    text-align:center;
    margin-left:auto;
    margin-right:auto;
  }

  /* ============ TARJETAS "CERCA DE TI" ============ */
  .tarjetas-local{
    display:grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  .tarjeta{
    background: var(--blanco);
    border: 1px solid var(--crema-linea);
    border-radius: var(--radio);
    padding: 22px;
    box-shadow: var(--sombra);
  }
  .tarjeta--acento{
    background: var(--marron);
    border-color: var(--marron);
    color: var(--crema);
  }
  .tarjeta__icono{
    width:42px; height:42px;
    border-radius:50%;
    background: var(--crema-oscura);
    display:flex;
    align-items:center;
    justify-content:center;
    margin-bottom:14px;
  }
  .tarjeta--acento .tarjeta__icono{ background: rgba(249,246,238,0.14); }
  .tarjeta__icono svg{ width:22px; height:22px; color: var(--rojo); }
  .tarjeta--acento .tarjeta__icono svg{ color: var(--crema); }
  
  .tarjeta p{
    margin:0 0 14px;
    font-size: 0.96rem;
  }

  .tarjeta--acento p{ color: rgba(249,246,238,0.85); }
  .tarjeta .subH3acento {
    color:white;
  }
  .tarjeta__mapa{
    border-radius: 10px;
    overflow:hidden;
    border: 1px solid var(--crema-linea);
    margin-top:6px;
  }
  .tarjeta__mapa iframe{
    width:100%;
    height:180px;
    border:0;
    display:block;
  }
  .lista-horario{ list-style:none; margin:0; padding:0; }
  .lista-horario li{
    display:flex;
    justify-content:space-between;
    padding: 7px 0;
    font-size: 0.94rem;
    border-bottom: 1px dashed var(--crema-linea);
  }
  .lista-horario li:last-child{ border-bottom:none; }
  .lista-horario span:last-child{ font-weight:700; color: var(--rojo); }
  .lista-horario__nota{
    margin: 10px 0 0;
    font-size: 0.82rem;
    color: var(--marron-suave);
  }

  /* ============ IDENTIDAD / HISTORIA ============ */
  .identidad{
    display:grid;
    gap: 30px;

  }

  
  .identidadGeneral {
    background:var(--crema-linea)
  }

  .identidad__historia p{
    font-size: 1.02rem;
    margin: 0 0 16px;
  }
  .identidad__firma{
    font-family: var(--font-display);
    font-style:italic;
    color: var(--rojo);
    border-left: 3px solid var(--rojo);
    padding-left: 16px;
    margin: 22px 0 0;
    font-size: 1.05rem;
  }
  .subH3{
    font-size: 1.2rem;
    font-weight:600;
    margin: 0 0 12px;
    background: var(--rojo);
    color:var(--blanco);
    text-align: center;
  }
  
  .subH3wa {
    color:var(--blanco);text-align: center;margin-bottom: 10px;
  }
  .lista-check{ list-style:none; display:grid; gap:12px; margin-top:6px; }
  .lista-check li{
    display:flex;
    gap:12px;
    align-items:flex-start;
    font-size:0.98rem;
  }
  .lista-check svg{
    width:20px; height:20px;
    color: var(--rojo);
    flex-shrink:0;
    margin-top:2px;
  }
  .lista-check a{ color: var(--rojo); font-weight:700; text-decoration: underline; }

  /* ============ PRODUCTOS ============ */
  .grid-productos{
    display:grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }
  .grid-productos--pasteleria{
    max-width: 980px;
    margin: 0 auto;
  }
  .tarjeta-producto{
    background: var(--blanco);
    border-radius: var(--radio);
    border: 1px solid var(--crema-linea);
    padding: 16px;
    box-shadow: var(--sombra);
    display:flex;
    flex-direction:column;
    gap:12px;
    overflow:hidden;
  }
  /* Foto cuadrada del producto: reemplazar el src por la foto real */
  .tarjeta-producto__foto{
    width:100%;
    aspect-ratio: 1 / 1;
    border-radius: 10px;
    overflow:hidden;
    background: var(--crema-oscura);
  }
  .tarjeta-producto__foto img{
    width:100%;
    height:100%;
    object-fit:cover;
  }
  .tarjeta-producto__cuerpo{
    padding: 0 8px 8px;
    display:flex;
    flex-direction:column;
    gap:10px;
    flex-grow:1;
  }
  .tarjeta-producto h3{ font-size: 1.15rem; font-weight:600; }
  .tarjeta-producto p{ margin:0; color: var(--marron-suave); font-size:0.95rem; flex-grow:1; }
  .tarjeta-producto__nota{
    display:inline-block;
    font-size: 0.78rem;
    font-weight:700;
    color: var(--rojo);
    background: rgba(157,26,4,0.08);
    padding: 5px 11px;
    border-radius: 999px;
    width: fit-content;
  }
  .tarjeta-producto__enlace{
    font-size: 0.9rem;
    font-weight:700;
    color: var(--marron);
    text-decoration:none;
    display:inline-flex;
    align-items:center;
    gap:6px;
    margin-top:4px;
  }
  .tarjeta-producto__enlace svg{ width:15px; height:15px; }
  .tarjeta-producto__enlace:hover{
   
    color: var(--rojo);
   
  }
  /* ============ REVENDEDORES ============ */
  .revendedores{
    display:grid;
    gap: 30px;
    align-items:center;
  }
  .revendedores__texto p{
    font-size: 1.02rem;
    color: rgba(249,246,238,0.85);
    margin: 0 0 16px;
  }
  .revendedores__lista{
    list-style:none;
    display:grid;
    gap:14px;
    margin: 22px 0 28px;
  }
  .revendedores__lista li{
    display:flex;
    gap:12px;
    align-items:flex-start;
    font-size: 0.98rem;
  }
  .revendedores__lista svg{
    width:20px; height:20px;
    color: #F0C9AE;
    flex-shrink:0;
    margin-top:2px;
  }
  .revendedores__tarjeta{
    background: rgba(249,246,238,0.06);
    border: 1px solid rgba(249,246,238,0.18);
    border-radius: var(--radio);
    padding: 26px;
  }
  .revendedores__tarjeta .subH3{ color: var(--crema); }
  .revendedores__tarjeta p{
    color: rgba(249,246,238,0.8);
    font-size: 0.96rem;
    margin: 0 0 20px;
  }

  /* ============ TESTIMONIOS ============ */
  .grid-testimonios{
    display:grid;
    grid-template-columns: 1fr;
    gap:18px;
  }
  .testimonio{
    background: var(--blanco);
    border-radius: var(--radio);
    padding: 24px;
    box-shadow: var(--sombra);
    border-top: 3px solid var(--rojo);
  }
  .testimonio__comillas{
    font-family: var(--font-display);
    font-size: 2.4rem;
    color: var(--rojo);
    line-height:0.4;
    display:block;
    margin-bottom: 14px;
  }
  .testimonio p{
    margin:0 0 16px;
    font-size: 0.98rem;
    font-style: italic;
  }
  .testimonio__autor{
    display:flex;
    align-items:center;
    gap:10px;
    font-style: normal;
  }
  .testimonio__avatar{
    width:36px; height:36px;
    border-radius:50%;
    background: var(--crema-oscura);
    color: var(--rojo);
    display:flex;
    align-items:center;
    justify-content:center;
    font-family: var(--font-display);
    font-weight:700;
    flex-shrink:0;
  }
  .testimonio__autor strong{ display:block; font-size:0.9rem; }
  .testimonio__autor span{ display:block; font-size:0.78rem; color: var(--marron-suave); }

  /* ============ FAQ ============ */
  .faq-lista{
    display:grid;
    gap: 12px;
  }
  .faq-item{
    background: var(--blanco);
    border: 1px solid var(--crema-linea);
    border-radius: var(--radio);
    overflow:hidden;
  }
  .faq-item summary{
    list-style:none;
    cursor:pointer;
    padding: 18px 20px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:16px;
    font-family: var(--font-display);
    font-weight:600;
    font-size: 1.02rem;
    color: var(--marron);
  }
  .faq-item summary::-webkit-details-marker{ display:none; }
  .faq-item__mas{
    width:26px; height:26px;
    border-radius:50%;
    border: 1.5px solid var(--rojo);
    color: var(--rojo);
    display:flex;
    align-items:center;
    justify-content:center;
    flex-shrink:0;
    position:relative;
  }
  .faq-item__mas::before,
  .faq-item__mas::after{
    content:"";
    position:absolute;
    background: var(--rojo);
    transition: transform .2s ease;
  }
  .faq-item__mas::before{ width:11px; height:2px; }
  .faq-item__mas::after{ width:2px; height:11px; }
  details[open] .faq-item__mas::after{ transform: rotate(90deg); opacity:0; }
  .faq-item__respuesta{
    padding: 0 20px 20px;
    color: var(--marron-suave);
    font-size: 0.97rem;
  }
  .faq-item__respuesta p{ margin:0; }

  /* ============ CTA FINAL ============ */
  .cta-final{
    background: var(--marron);
    color: var(--crema);
    text-align:center;
    padding: 56px 0 60px;
  }
  .cta-final h2{
    color: var(--crema);
    font-size: clamp(1.6rem, 5vw, 2.2rem);
    font-weight:600;
    max-width: 560px;
    margin: 0 auto;
  }
  .cta-final p{
    color: rgba(249,246,238,0.75);
    max-width: 460px;
    margin: 14px auto 28px;
  }

  .cta-final .boton--secundario{
    border-color: rgba(249,246,238,0.5);
    color: var(--crema);
  }
  .cta-final .boton--secundario:hover{
    background: var(--crema);
    color: var(--marron);
  }
  .cta-final__acciones{
    display:flex;
    flex-direction:column;
    gap:12px;
    align-items:center;
  }
  
  .cta-final__telefono{
    margin-top: 22px;
    font-family: var(--font-display);
    font-size: 1.2rem;
    letter-spacing: 0.03em;
  }
  /* ============ ACCESIBILIDAD ============ */
  a:focus-visible,
  button:focus-visible,
  summary:focus-visible,
  label:focus-visible{
    outline: 3px solid var(--rojo);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce){
    *{ scroll-behavior:auto !important; transition:none !important; }
  }

  /* ============ TABLET / DESKTOP (min-width) ============ */
  @media (min-width: 640px){
    .hero__acciones{ flex-direction:row; justify-content:center; }
    .hero__acciones .boton{ width:auto; }
    .tarjetas-local{ grid-template-columns: repeat(2, 1fr); }
    .tarjetas-local .tarjeta:first-child{ grid-column: 1 / -1; }
    .grid-productos{ grid-template-columns: repeat(2, 1fr); }
    .grid-testimonios{ grid-template-columns: repeat(3, 1fr); }
    .cta-final__acciones{ flex-direction:row; justify-content:center; }
    
  }

  @media (min-width: 900px){
  
    .hero__contenido{ padding: 96px 0 92px; }
    .hero__logo{ width:200px; height:200px; }
    .identidad{ grid-template-columns: 1.1fr 0.9fr; align-items:start; }
    .revendedores{ grid-template-columns: 1.05fr 0.95fr; }
    .tarjetas-local{ grid-template-columns: 1.1fr 0.9fr 0.9fr; }
    .tarjetas-local .tarjeta:first-child{ grid-column: auto; }
    .grid-productos{ grid-template-columns: repeat(4, 1fr); }
    .grid-productos--pasteleria{ grid-template-columns: repeat(3, 1fr); }
    .bloque{ padding: 76px 0; }
    
  }
	</style>
	<body>
		<Header />
		   <main id="inicio">

  <!-- ============ HERO CON IMAGEN DE FONDO ============ -->
  <!-- Reemplaza __HERO_FONDO_B64__ por la foto real del mostrador u horno, igual que el logo -->
  <section class="hero">
    <img class="hero__foto-fondo" src="src/assets/img/home/fondo-productos-panaderia-dorita.jpg" alt="productos artesanales de panaderia dorita en piura" loading="eager">
    <div class="hero__velo"></div>
    <div class="contenedor hero__contenido">
      <img class="hero__logo" src="logo-panaderia-dorita.jpg" alt="Logo Panadería Dorita: manos sosteniendo un pan recién horneado">
      <span class="eyebrow eyebrow--claro">Panadería de barrio en Piura desde 1985</span>
      <h1>Tu panadería artesanal que nació en tu barrio, llena de tradición</h1>
      <p class="hero__slogan">"El pan se parte con las manos, pero se comparte con el corazón"</p>
      <p class="hero__texto">Desde 1985 horneamos como en casa, en el AA.HH. 18 de Mayo, manzana "Q" lote 18. Pan fresco todos los días, tortas, bocaditos y rosquitas hechas a mano — sin atajos y sin cadenas industriales de por medio.</p>
      <div class="hero__acciones">
         <a class="boton boton-primario"
           href="https://wa.me/51993955358?text=Hola%2C%20quiero%20pedir%20bocaditos%20para%20mi%20evento"
           target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.02 2C6.5 2 2.02 6.48 2.02 12c0 1.85.5 3.58 1.36 5.07L2 22l5.08-1.33A9.96 9.96 0 0 0 12.02 22C17.55 22 22 17.52 22 12S17.55 2 12.02 2zm5.87 14.2c-.25.7-1.45 1.33-2 1.42-.51.08-1.16.11-1.87-.12-.43-.14-.98-.32-1.7-.63-2.98-1.29-4.93-4.28-5.08-4.48-.15-.2-1.22-1.62-1.22-3.09 0-1.47.77-2.19 1.05-2.49.27-.3.6-.37.8-.37.2 0 .4 0 .57.01.18.01.43-.07.67.51.25.6.85 2.07.92 2.22.07.15.12.33.02.53-.1.2-.15.32-.3.5-.15.18-.31.4-.44.53-.15.15-.3.31-.13.6.17.3.76 1.25 1.63 2.02 1.12 1 2.06 1.31 2.36 1.46.3.15.48.13.65-.08.18-.2.75-.87.95-1.17.2-.3.4-.25.67-.15.27.1 1.73.82 2.02.97.3.15.5.22.57.35.07.13.07.75-.18 1.45z"/>
          </svg>
          Pedir por WhatsApp
        </a>
        <a class="boton boton--sobre-foto" href="#ubicacion">Ver ubicación y horario</a>
      </div>
      <ul class="hero__badges">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Más de 40 años en el barrio</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Pan horneado todos los días</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Peso justo, siempre</li>
      </ul>
    </div>
  </section>

  <svg class="divisor divisor--a" viewBox="0 0 1200 30" preserveAspectRatio="none" aria-hidden="true">
    <polygon points="0,12 46,6 92,14 138,22 185,3 231,4 277,19 323,5 369,13 415,20 462,3 508,18 554,8 600,3 646,4 692,15 738,15 785,4 831,9 877,4 923,19 969,15 1015,3 1062,20 1108,5 1154,9 1200,22 1200,30 0,30"/>
  </svg>

  <!-- ============ UBICACIÓN / HORARIO / WHATSAPP ============ -->
  <section id="ubicacion" class="bloque bloque--oscuro">
    <div class="contenedor">
      <div class="bloque__cabecera">
        <span class="eyebrow">Cerca de ti</span>
        <h2>Pan fresco todos los días, a pocos minutos de tu casa</h2>
        <p>Si estás buscando una panadería cerca de ti en Piura, llegaste al lugar correcto. Aquí no hay vueltas: te decimos dónde estamos, cuándo abrimos y cómo pedir en un solo mensaje.</p>
      </div>

      <div class="tarjetas-local">
        <div class="tarjeta">
          <div class="tarjeta__icono">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>
          </div>
          <h3>Ubicación y cómo llegar</h3>
          <p>AA.HH. 18 de Mayo, manzana Q, lote 18, Piura. Pregunta por "la panadería de Doña Dorita" — cualquier vecino te indica el camino.</p>
          <div class="tarjeta__mapa">
            <iframe src="https://www.google.com/maps?q=AA.HH.+18+de+Mayo,+Piura,+Peru&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Mapa Panadería Dorita, AA.HH. 18 de Mayo, Piura"></iframe>
          </div>
        </div>

        <div class="tarjeta">
          <div class="tarjeta__icono">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
          </div>
          <h3>Horario de atención</h3>
          <p>Encendemos el horno dos veces al día para que siempre lleves pan recién salido, mañana y tarde.</p>
          <ul class="lista-horario">
            <li><span>Turno mañana</span><span>6:00 am – 10:00 am</span></li>
            <li><span>Turno tarde</span><span>5:00 pm – 10:00 pm</span></li>
          </ul>
          <p class="lista-horario__nota">Todos los días, incluidos domingos y feriados.</p>
        </div>

        <div class="tarjeta tarjeta--acento">
          <div class="tarjeta__icono">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 12a8 8 0 1 1-3.8-6.8L20 4l-1.2 3.8A8 8 0 0 1 20 12Z"/><path d="M8.5 9.5c.3 2.6 2.4 4.7 5 5"/></svg>
          </div>
          <h3 class="subH3wa">Pide directo por WhatsApp</h3>
          <p>No hace falta venir a preguntar si hay pan. Escríbenos y te respondemos al toque.</p>
