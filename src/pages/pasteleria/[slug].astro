---
import { getCollection, type CollectionEntry } from 'astro:content';
import { NEGOCIO } from '../../lib/negocio';
import LayoutPasteleria from '../../layouts/LayoutPasteleria.astro';
import HistoriaBocaditos from '../../components/pasteleria/bocaditos/HistoriaBocaditos.astro'
import CategoriaProductos from '../../components/pasteleria/bocaditos/CategoriaProducto.astro'
import PrecioBocaditos from '../../components/pasteleria/bocaditos/PrecioBocaditos.astro'
import TarjetasTortas from '../../components/pasteleria/tortas/TarjetasTortas.astro';
import PreciosTortas from '../../components/pasteleria/tortas/PreciosTortas.astro';
import ElegirnosTortas from '../../components/pasteleria/tortas/ElegirnosTortas.astro';

// 1. Obtener todas las rutas estáticas
export async function getStaticPaths() {
  const productos = await getCollection('pasteleria');
  return productos.map(producto => ({
    params: { slug: producto.data.slug },
    props: { producto },
  }));
}

interface Props {
  producto: CollectionEntry<'pasteleria'>;
}

// 2. Extraer el producto
const { producto } = Astro.props as Props;
const { data } = producto;

const url = `${NEGOCIO.siteUrl}/pasteleria/${data.slug}/`;

// ===== Breadcrumb =====
const breadcrumbItems = [
  { "@type": "ListItem", "position": 1, "name": "Panaderia Dorita", "item": `${NEGOCIO.siteUrl}/` },
];

if (data.migasPan.categoria) {
  breadcrumbItems.push({
    "@type": "ListItem",
    "position": 2,
    "name": data.migasPan.categoria.nombreCategoria,
    "item": `${NEGOCIO.siteUrl}${data.migasPan.categoria.slugCategoria}/`,
  });
}

breadcrumbItems.push({
  "@type": "ListItem",
  "position": breadcrumbItems.length + 1,
  "name": data.migasPan.textoFinal,
  "item": url,
});

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems,
};

// ===== FAQ =====
const faqSchema = data.faq
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": data.faq.map((f) => ({
        "@type": "Question",
        "name": f.pregunta,
        "acceptedAnswer": { "@type": "Answer", "text": f.respuesta },
      })),
    }
  : null;

// Array final que se pasa al layout -> BaseHead
const structuredData = [breadcrumb, ...(faqSchema ? [faqSchema] : [])];
---
<LayoutPasteleria {...producto.data} structuredData={structuredData} imagenProducto={data.imagenProducto}>
  {producto.data.slug === "tortas-piura" && (
    <TarjetasTortas slot="categoriasTortas" />
  )}
  {producto.data.categoriasProductos && (
    <Fragment slot="categorias">
      {producto.data.categoriasProductos.map((c) => <CategoriaProductos {...c} />)}
    </Fragment>
  )}
   {producto.data.slug === "tortas-piura" && (
    <PreciosTortas slot="precioTortas" />
  )}
    {producto.data.slug === "tortas-piura" && (
    <ElegirnosTortas slot="elegirnosTortas" />
  )}
  {producto.data.slug === "bocaditos-piura" && (
    <PrecioBocaditos slot="precioBocadito" />
  )}

  {producto.data.slug === "bocaditos-piura" && (
    <HistoriaBocaditos slot="historia" />
  )}
</LayoutPasteleria>