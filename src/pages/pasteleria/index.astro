---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import '../../styles/global.css'
import MigasPan from '../../components/MigasPan.astro';
import { Image, getImage } from 'astro:assets';
import * as Variables from '../../consts';
import HeaderLink  from '../../components/HeaderLink.astro';

const site = "https://panaderiadorita.online";

const tortaImg = await getImage({ src: Variables.TortasImg, format: 'webp' });
const tortaImgUrl = `${site}${tortaImg.src}`;

const bocaditosDulcesImg = await getImage({ src: Variables.BocaditosDulcesImg, format: 'webp' });
const bocaditosDulcesImgUrl = `${site}${bocaditosDulcesImg.src}`;

const bocaditosSaladosImg = await getImage({ src: Variables.BocaditosSaladosImg, format: 'webp' });
const bocaditosSaladosImgUrl = `${site}${bocaditosSaladosImg.src}`;

const itemListJsonLd = `{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Pastelería artesanal Panadería Dorita",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "item": {
        "@type": "Product",
        "name": "Tortas personalizadas",
        "image": "${tortaImgUrl}",
        "description": "Nada de molde de fábrica ni catálogo cerrado: cuéntanos la ocasión, el sabor y cómo la imaginas, y la armamos contigo con la misma receta de siempre desde 1985. Pide con 1 día de anticipación y asegura tu fecha.",
        "url": "https://panaderiadorita.online/pasteleria/tortas-piura/",
        "brand": {
          "@type": "Brand",
          "name": "Panadería Dorita"
        },
        "offers": {
          "@type": "Offer",
          "price": "150.00",
          "priceCurrency": "PEN",
          "availability": "https://schema.org/InStock"
        }
      }
    },
    {
      "@type": "ListItem",
      "position": 2,
      "item": {
        "@type": "Product",
        "name": "Bocaditos dulces",
        "image": "${bocaditosDulcesImgUrl}",
        "description": "Bocaditos dulces artesanales, S/60 el ciento.Para cumpleaños, reuniones familiares, juntas de trabajo y cualquier ocasión que merezca una mesa bien servida.",
        "brand": {
          "@type": "Brand",
          "name": "Panadería Dorita"
        },
        "url": "https://panaderiadorita.online/pasteleria/bocaditos-piura/#dulces",
        "offers": {
          "@type": "Offer",
          "price": "60.00",
          "priceCurrency": "PEN",
          "availability": "https://schema.org/InStock"
        }
      }
    },
    {
      "@type": "ListItem",
      "position": 3,
      "item": {
        "@type": "Product",
        "name": "Bocaditos salados",
        "image": "${bocaditosSaladosImgUrl}",
        "description": "Bocaditos salados artesanales, S/60 el ciento.Para cumpleaños, reuniones familiares, juntas de trabajo y cualquier ocasión que merezca una mesa bien servida.",
        "url": "https://panaderiadorita.online/pasteleria/bocaditos-piura/#salados",
        "brand": {
          "@type": "Brand",
          "name": "Panadería Dorita"
        },
        "offers": {
          "@type": "Offer",
          "price": "60.00",
          "priceCurrency": "PEN",
          "availability": "https://schema.org/InStock"
        }
      }
    }
  ]
}`;

const migasPan = {
  textoFinal:'',
  categoria: {
    nombreCategoria: "Pasteleria Tradicional",
    slugCategoria: "/pasteleria"
  }
};
---

<!DOCTYPE html>
<html lang="es-PE">
<head>
 <BaseHead title="Pastelería Tradicional en Piura | Panadería Dorita" description="En Piura, las reuniones familiares saben mejor con tortas y bocaditos artesanales, con el mismo sabor de siempre ¡Pídelos por WhatsApp!"/>

<!-- Schema: BreadcrumbList -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://panaderiadorita.com/" },
    { "@type": "ListItem", "position": 2, "name": "Pastelería en Piura", "item": "https://panaderiadorita.com/pasteleria/" }
  ]
}
</script>

<script type="application/ld+json" set:html={itemListJsonLd} />

<!-- Schema: FAQPage -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Qué significa que Panadería Dorita sea una pastelería artesanal?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Que todo lo hacemos con las manos, no con máquinas industriales ni recetas de fábrica. Desde 1985, cuando Don Víctor y Doña Dorita abrieron el negocio, Don Óscar es el maestro que hornea cada torta y cada bocadito siguiendo la misma receta de siempre. Artesanal para nosotros no es una palabra bonita: es que cada pedido se amasa, se rellena y se decora a mano, el mismo día o el día anterior a su entrega, no semanas antes en una fábrica."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué productos de pastelería hacen en Panadería Dorita?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Hacemos tortas para cumpleaños y celebraciones, bocaditos dulces y bocaditos salados para reuniones o eventos. Puede pedir todo junto o por separado, según lo que necesite para su celebración."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto cuesta una torta artesanal en Panadería Dorita?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El precio depende del tamaño, el relleno y el diseño que quiera, así que no manejamos una tarifa única. Lo más rápido es escribirnos por WhatsApp al +51 993 955 358 contándonos para cuántas personas es y qué tiene en mente; en minutos le damos el precio exacto sin compromiso."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto cuestan los bocaditos dulces y salados?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Los bocaditos, tanto dulces como salados, cuestan S/60 el ciento. Si necesita una cantidad distinta o quiere combinar dulces y salados para su evento, escríbanos por WhatsApp al +51 993 955 358 y le armamos la cantidad exacta que necesita."
      }
    },
    {
      "@type": "Question",
      "name": "¿Con cuánta anticipación debo pedir una torta o bocaditos?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Para tortas necesitamos un día de anticipación, y para bocaditos, dos días. Esto nos permite prepararlos frescos, a mano, sin apurar la receta. Si su evento es en menos tiempo, igual escríbanos por WhatsApp al +51 993 955 358: si hay disponibilidad, hacemos lo posible por ayudarlo."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cómo puedo hacer mi pedido y cómo pago?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Todo el pedido se coordina por WhatsApp al +51 993 955 358: usted nos cuenta qué necesita, le confirmamos el precio y la fecha, y para asegurar su pedido puede pagar con Yape o Plin un adelanto de S/20 o el 20% del total, lo que sea mayor. El resto se cancela al recoger."
      }
    },
    {
      "@type": "Question",
      "name": "¿Hacen tortas personalizadas para cumpleaños u otras celebraciones?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí, hacemos tortas personalizadas para cumpleaños, y también trabajamos con bocaditos para cualquier tipo de reunión o celebración familiar. Cuéntenos el tema, el sabor y para cuántas personas es por WhatsApp al +51 993 955 358, y Don Óscar la prepara a la medida de su celebración."
      }
    },
    {
      "@type": "Question",
      "name": "¿Dónde está ubicada Panadería Dorita en Piura?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Estamos en AA.HH. 18 de Mayo, manzana Q, lote 18, en Piura. Ahí mismo puede recoger su pedido de tortas o bocaditos una vez coordinado por WhatsApp."
      }
    },
    {
      "@type": "Question",
      "name": "¿Desde cuándo existe Panadería Dorita y quién hace las tortas y bocaditos?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Panadería Dorita abrió sus puertas en 1985, fundada por Don Víctor y Doña Dorita. Don Óscar, quien aprendió el oficio desde esos primeros años, sigue siendo hoy el maestro panadero a cargo de las recetas. Más de 30 años después, seguimos horneando con las mismas manos y la misma receta de siempre."
      }
    },
    {
      "@type": "Question",
      "name": "¿Las tortas y bocaditos se hacen el mismo día o son congelados?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Se hacen frescos para su pedido, no manejamos productos congelados de fábrica. Por eso pedimos anticipación: un día para tortas y dos días para bocaditos, el tiempo justo para prepararlos a mano y que lleguen recién hechos a su mesa."
      }
    }
  ]
}
</script>

<style>


  .container{
    width: 100%;
    max-width: var(--ancho-maximo);
    margin-inline: auto;
    padding-inline: 20px;
  }

  .eyebrow{
    display:inline-flex;
    align-items:center;
    gap:8px;
    font-family: var(--font-cuerpo);
    font-weight:700;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rojo);
  }
   .hero__eyebrow{
    font-family:var(--font-cuerpo);
    font-weight:700;
    font-size:.72rem;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:var(--crema);
    background:var(--rojo);
    border:1px solid var(--borde);
    padding:6px 12px;
    border-radius:999px;
    margin-bottom:18px;
  }
  .eyebrow::before{
    content:"";
    width:18px; height:2px;
    background: var(--rojo);
    display:inline-block;
  }

  section{ padding-block: 56px; }
  section + section{ border-top: 1px solid rgba(74,46,43,0.08); }

  .lead{
    font-size: 1.05rem;
    color: var(--marron);
    max-width: 62ch;
  }

  /* ============================================
     BOTONES
     ============================================ */
  .boton-ghost{
    background: transparent;
    color: var(--marron);
    border-color: rgba(74,46,43,0.3);
  }
  .boton-ghost:hover{ border-color: var(--marron); background: rgba(74,46,43,0.05); }
  .boton-sm{ padding: 10px 18px; font-size: 0.88rem; }



  /* ============================================
     HERO
     ============================================ */
  .hero-cat{
    position:relative;
    padding-block: 52px 60px;
    background:
      radial-gradient(circle at 100% 0%, rgba(157,26,4,0.07), transparent 55%),
      var(--crema-oscura);
    overflow:hidden;
  }
  .hero-cat::after{
    content:"";
    position:absolute;
    right:-60px; bottom:-60px;
    width:220px; height:220px;
    border-radius:50%;
    background: rgba(157,26,4,0.06);
  }
  .hero-cat__inner{ position:relative; max-width: 640px; }
  .hero-cat h1{
    font-size: clamp(2rem, 6vw, 2.9rem);
    font-weight: 600;
    margin-block: 14px 16px;
  }
  .hero-cat .lead{ margin-bottom: 26px; }

  .hero-cta-row{
    display:flex;
    flex-wrap:wrap;
    gap: 12px;
    margin-bottom: 30px;
  }

  .hero-badges{
    display:flex;
    flex-wrap:wrap;
    gap: 10px 18px;
  }
  .hero-badge{
    display:flex;
    align-items:center;
    gap:8px;
    font-size: 0.85rem;
    font-weight:600;
    color: var(--marron);
  }
  .hero-badge .dot{
    width:6px; height:6px;
    border-radius:50%;
    background: var(--rojo);
    flex-shrink:0;
  }

  /* ============================================
     SECCION: PRODUCTOS
     ============================================ */
  .seccion-head{ max-width: 640px; margin-bottom: 34px; }
  .seccion-head h2{
    font-size: clamp(1.55rem, 4.5vw, 2.1rem);
    font-weight: 600;
    margin-top: 12px;
  }
  .seccion-head p{ margin-top: 12px; color: var(--marron); }

  .productos-grid{
    display:grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }
  .producto-card{
    background:#fff;
    border: 1px solid rgba(74,46,43,0.1);
    border-radius: var(--radius-m);
    padding: 26px;
    display:flex;
    flex-direction:column;
    gap: 14px;
    box-shadow: 0 1px 2px rgba(43,33,30,0.04);
  }
  .producto-card__precio{
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--rojo);
    font-weight:600;
  }
  .producto-card__precio small{
    font-family: var(--font-cuerpo);
    font-size: 0.8rem;
    font-weight:600;
    color: var(--marron);
    display:block;
    margin-top:2px;
  }
  .producto-card h3{
    font-size: 1.25rem;
    font-weight:600;
    color:var(--rojo);
  }
  .producto-card p{
    color: var(--marron);
    font-size: 0.96rem;
    flex-grow:1;
  }

  .producto-card img {
  border-radius: 15px;
  object-fit: cover;
}
  .producto-card__footer{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    padding-top: 6px;
    border-top: 1px dashed rgba(74,46,43,0.18);
  }
  .producto-card__link{
    font-weight:700;
    font-size: 0.9rem;
    color: var(--marron);
    text-decoration:none;
  }
  .producto-card__link:hover{ color: var(--rojo); }

  /* ============================================
     SECCION: ARTESANAL (historia)
     ============================================ */
     
  .artesanal {
      background: var(--crema-oscura);
     }


  .artesanal-grid{
    display:grid;
    grid-template-columns: 1fr;
    gap: 30px;
  }
  .artesanal-item h3{
    font-size: 1.2rem;
    font-weight:600;
    margin-bottom: 10px;
  }
  .artesanal-item p{ color: var(--marron); }
  .artesanal-item p + p{ margin-top: 10px; }

  .lista-check{ list-style:none; margin-top: 14px; display:flex; flex-direction:column; gap:8px; }
  .lista-check li{
    display:flex;
    gap:10px;
    align-items:flex-start;
    color: var(--marron);
    font-size: 0.95rem;
  }
  .lista-check li::before{
    content:"";
    width:8px; height:8px;
    margin-top:7px;
    flex-shrink:0;
    border-radius:50%;
    background: var(--rojo);
  }

  .sello{
    display:inline-flex;
    align-items:center;
    gap:10px;
    background: var(--crema-oscura);
    border: 1px solid rgba(74,46,43,0.15);
    border-radius: 999px;
    padding: 8px 16px;
    font-size: 0.82rem;
    font-weight:700;
    color: var(--marron);
    margin-bottom: 18px;
  }

  /* ============================================
     SECCION: COMO PEDIR
     ============================================ */
  .pasos{
    list-style:none;
    counter-reset: paso;
    display:flex;
    flex-direction:column;
    gap: 16px;
    margin: 28px 0 40px;
  }
  .pasos li{
    counter-increment: paso;
    display:grid;
    grid-template-columns: 40px 1fr;
    gap: 14px;
    align-items:start;
  }
  .pasos li::before{
    content: counter(paso);
    font-family: var(--font-display);
    font-weight:600;
    width:40px; height:40px;
    border-radius:50%;
    background: var(--rojo);
    color:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size: 1.05rem;
  }
  .pasos li p{ margin:0; color: var(--marron); padding-top:6px; }
  .pasos li strong{ color: var(--tinta); }

  .info-grid{
    display:grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }
  .info-card{
    background:var(--secundario);
    border-radius: var(--radius-m);
    border: 1px solid rgba(74,46,43,0.1);
    padding: 22px;
  }
  .info-card h3{ font-size: 1.05rem; font-weight:600; margin-bottom:10px; }
  .info-card p{ color: var(--marron); font-size: 0.94rem; }
  .info-card .valor{
    font-family: var(--font-display);
    color: var(--rojo);
    font-size: 1.4rem;
    font-weight:600;
    margin-bottom: 6px;
    display:block;
  }

  /* ============================================
     SECCION: UBICACION
     ============================================ */
  .ubicacion-wrap{
    display:grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items:start;
  }
  .direccion-card{
    background: var(--marron);
    color: var(--crema);
    border-radius: var(--radius-m);
    padding: 28px;
  }
  .direccion-card h3{ color:#fff; font-size:1.15rem; font-weight:600; margin-bottom:10px;}
  .direccion-card p{ color: rgba(249,246,238,0.85); margin-bottom:20px; }
  .mapa-embed{
    border-radius: var(--radius-m);
    overflow:hidden;
    border: 1px solid rgba(74,46,43,0.15);
    aspect-ratio: 4/3;
  }
  .mapa-embed iframe{ width:100%; height:100%; border:0; }

  /* ============================================
     FAQ
     ============================================ */
  .faq-list{ margin-top: 30px; display:flex; flex-direction:column; gap: 12px; }
  .faq-item{
    background:#fff;
    border: 1px solid rgba(74,46,43,0.12);
    border-radius: var(--radius-s);
    overflow:hidden;
  }
  .faq-item summary{
    list-style:none;
    cursor:pointer;
    padding: 18px 20px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap: 16px;
    font-weight:700;
    font-size: 0.98rem;
    color: var(--rojo);
  }
  .faq-item summary::-webkit-details-marker{ display:none; }
  .faq-item summary .icon{
    flex-shrink:0;
    width:24px; height:24px;
    border-radius:50%;
    background: var(--crema-2);
    color: var(--rojo);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size: 1rem;
    font-weight:700;
    transition: transform .2s ease;
  }
  .faq-item[open] summary .icon{ transform: rotate(45deg); }
  .faq-item .faq-answer{
    padding: 0 20px 20px;
    color: var(--marron);
    font-size: 0.95rem;
  }

  /* ============================================
     CTA FINAL (no es footer del sitio, cierre del contenido)
     ============================================ */
  .cta-final{
    background: var(--rojo);
    border-radius: var(--radius-l);
    padding: 40px 28px;
    text-align:center;
    color:#fff;
  }
  .cta-final h2{ color:#fff; font-size: clamp(1.4rem, 5vw, 1.9rem); font-weight:600; }
  .cta-final p{ color: rgba(255,255,255,0.9); margin: 12px 0 24px; }
  .cta-final .botonn-primario{
    background:#fff;
    color: var(--rojo);
    box-shadow: 0 6px 0 rgba(0,0,0,0.15);
  }

  /* ============================================
     RESPONSIVE — TABLET / DESKTOP
     ============================================ */
  @media (min-width: 640px){
    .productos-grid{ grid-template-columns: repeat(2, 1fr); }
    .info-grid{ grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 900px){
    section{ padding-block: 76px; }
    .hero-cat{ padding-block: 90px 100px; }
    .hero-cat__inner{ max-width: 800px; }

    .productos-grid{ grid-template-columns: repeat(3, 1fr); }
    .artesanal-grid{ grid-template-columns: repeat(2, 1fr); gap: 48px; }
    .ubicacion-wrap{ grid-template-columns: 1.1fr 1fr; }
    .pasos{ max-width: 620px; }
  }

  @media (prefers-reduced-motion: reduce){
    *{ scroll-behavior:auto !important; transition:none !important; }
  }
</style>
</head>
<body>

 	<Header />
  
<main>

  <!-- ============================================
       HERO
       ============================================ -->
  <section class="hero-cat">
    <MigasPan migasPan={migasPan}/>
    <div class="container hero-cat__inner">
      
      <span class="hero__eyebrow">Pastelería tradicional en Piura</span>
      <h1>Pastelería Artesanal en Piura: Tortas y Bocaditos tradicionales desde 1985</h1>
      <p class="lead">Bienvenido a la pastelería de tu barrio de AA.HH 18 de mayo. Amasamos, rellenamos y decoramos a mano cada torta y cada bocadito, tal como lo hacía Doña Dorita desde 1985. Nada sale de fábrica: sale de nuestro horno artesanal, con la receta de siempre.</p>

      <div class="hero-cta-row">
        <a class="boton boton-primario" href="https://wa.me/51993955358" target="_blank" rel="noopener">Pedir por WhatsApp</a>
        <a class="boton boton-ghost" href="#pastelería-artesanal">Ver tortas y bocaditos</a>
      </div>

      <div class="hero-badges">
        <span class="hero-badge"><span class="dot"></span>Desde 1985</span>
        <span class="hero-badge"><span class="dot"></span>Hecho a mano, sin fábrica</span>
        <span class="hero-badge"><span class="dot"></span>Recojo en AA.HH. 18 de Mayo</span>
      </div>
    </div>
  </section>

  <!-- ============================================
       NUESTRA PASTELERÍA ARTESANAL
       ============================================ -->
  <section id="pastelería-artesanal">
    <div class="container">
      <div class="seccion-head">
        <span class="eyebrow">Qué encontrarás</span>
        <h2>Nuestra pastelería artesanal: tortas, bocaditos dulces y salados</h2>
        <p>Todo lo que hacemos se prepara fresco, para su pedido, no para una vitrina que espera días. Aquí le contamos qué encontrará y cuánto invertir, para que decida sin vueltas.</p>
      </div>

      <div class="productos-grid">

        <article class="producto-card">
          <div class="producto-card__precio">Cotización<small>Según tamaño y diseño</small></div>
          <h3>Tortas personalizadas</h3>
