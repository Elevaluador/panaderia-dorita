---
interface Props {
 
 tituloFinal: string;
 textoFinal: string;
 
}

const {
tituloFinal,
textoFinal,
} = Astro.props;

---
<style>

/* =========================================================
   BASE  (Mobile First)
   ========================================================= */

.container{
  width:100%;
  max-width:1160px;
  margin:auto;
  padding:0 20px;
}

/* =========================================================
   CTA FINAL  (Mobile base)
   ========================================================= */
.cta-final{
  padding:55px 0 65px;
  background:
    linear-gradient(
      145deg,
      var(--rojo),
      var(--rojo-oscuro)
    );
  color:white;
  text-align:center;
}

.cta-final h2{
  max-width:680px;
  margin:auto;
  color:white;
  font-size:clamp(26px,5.5vw,43px);
}

.cta-final p{
  max-width:500px;
  margin:15px auto 0;
  font-size:16px;
  opacity:.9;
}

.cta-final .boton{
  margin-top:27px;
}

.cta-final .phone-line{
  margin-top:16px;
  font-size:14px;
  opacity:.8;
}


/* =========================================================
   TABLET  (min-width: 640px)
   ========================================================= */
@media(min-width:640px){

  .container{
    padding:0 32px;
  }

  
  .cta-final{
    padding:75px 0 85px;
  }
}


/* =========================================================
   DESKTOP  (min-width: 920px)
   ========================================================= */
@media(min-width:920px){

  
  .cta-final{
    padding:90px 0 100px;
  }

}

</style>

<!-- =========================================================
     CTA FINAL
     ========================================================= -->

<section class="cta-final">

  <div class="container">

    <h2>
      {
tituloFinal
} 
    </h2>

    <p>
      {textoFinal} 
    </p>


    <a
      class="boton boton-light"
      href="https://wa.me/51993955358?text=Hola%2C%20quiero%20pedir%20bocaditos"
      target="_blank"
      rel="noopener"
    >

      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M12.02 2C6.5 2 2.02 6.48 2.02 12c0 1.85.5 3.58 1.36 5.07L2 22l5.08-1.33A9.96 9.96 0 0 0 12.02 22C17.55 22 22 17.52 22 12S17.55 2 12.02 2zm5.87 14.2c-.25.7-1.45 1.33-2 1.42-.51.08-1.16.11-1.87-.12-.43-.14-.98-.32-1.7-.63-2.98-1.29-4.93-4.28-5.08-4.48-.15-.2-1.22-1.62-1.22-3.09 0-1.47.77-2.19 1.05-2.49.27-.3.6-.37.8-.37.2 0 .4 0 .57.01.18.01.43-.07.67.51.25.6.85 2.07.92 2.22.07.15.12.33.02.53-.1.2-.15.32-.3.5-.15.18-.31.4-.44.53-.15.15-.3.31-.13.6.17.3.76 1.25 1.63 2.02 1.12 1 2.06 1.31 2.36 1.46.3.15.48.13.65-.08.18-.2.75-.87.95-1.17.2-.3.4-.25.67-.15.27.1 1.73.82 2.02.97.3.15.5.22.57.35.07.13.07.75-.18 1.45z"/>
      </svg>

      Pedir por WhatsApp

    </a>


    <p class="phone-line">
      +51 993 955 358 · AA.HH. 18 de Mayo, Mz. Q, Lote 18, Piura
    </p>

  </div>

</section>