---
interface Tarjeta {
  num: string;
  titulo: string;
  texto: string;
}

interface Props {
  subtituloPedir: string;
  tituloPedir: string;
  tarjetas: Tarjeta[];
  
}

const { subtituloPedir, tituloPedir, tarjetas } = Astro.props;
---

<style>


.container{
  width:100%;
  max-width:1120px;
  margin:0 auto;
  padding:0 20px;
}
.eyebrow{
  font-family:var(--font-cuerpo);
  font-weight:700;
  font-size:0.72rem;
  letter-spacing:0.14em;
  text-transform:uppercase;
  color:var(--rojo);
}


/* ===== TOPBAR ===== */
.contenedor{
  width:100%;
  max-width:1120px;
  margin:0 auto;
  padding:0 20px;
}


/* ===== SECTIONS ===== */
section{padding:44px 0;}
.section-white{background:var(--blanco);}
.section-head{margin-bottom:22px;}
.section-head .eyebrow{margin-bottom:8px; display:block;}


/* ===== HOW TO ORDER ===== */
.order-grid{
  display:grid; gap:18px;
}
.order-card{
  background:var(--blanco);
  border:1px solid var(--borde);
  border-radius:16px;
  padding:22px;
  box-shadow:var(--sombra);
  position:relative;
}
.order-card .num{
  font-family:var(--font-cuerpo);
  font-size:0.8rem; font-weight:700;
  color:var(--rojo);
  text-transform:uppercase;
  letter-spacing:0.08em;
  margin-bottom:8px; display:block;
}
.order-card h3{margin-bottom:8px;  color:var(--rojo)}
.order-final{
  background:var(--crema-oscura);
  border:1px dashed var(--rojo);
  border-radius:14px;
  padding:18px 20px;
  margin-top:8px;
  display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:14px;
}
.order-final p{margin-bottom:0; font-weight:700; color:var(--marron);}


/* ===== TABLET / DESKTOP ===== */
@media (min-width:760px){
  .order-grid{grid-template-columns:repeat(3,1fr);}
  
}
@media (min-width:1000px){
  
  section{padding:64px 0;}

}
</style>

<!-- ===== COMO PEDIR ===== -->
  <section class="section-white">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{subtituloPedir}</span>
        <h2>{tituloPedir}</h2>
      </div>
       <div class="order-grid">
      {tarjetas.map((tarjeta) => (
        <div class="order-card">
          <span class="num">{tarjeta.num}</span>
          <h3>{tarjeta.titulo}</h3>
          <p style="margin-bottom:0;">{tarjeta.texto}</p>
        </div>
      ))}
    </div>
      <div class="order-final">
        <p>¿Listo para pedir?</p>
        <a href="https://wa.me/51993955358" class="boton boton-primario" target="_blank" rel="noopener">WhatsApp: +51 993 955 358</a>
      </div>
    </div>
  </section>