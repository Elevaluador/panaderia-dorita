---
interface Props {
  tituloPrecios?: string;
  tarjetas: {
    monto: string;
    unidad: string;
    titulo: string;
    descripcion: string;
    textoBoton: string;
    hrefBoton: string;
  }[];
}

const { tituloPrecios, tarjetas } = Astro.props;
---


<style>
  .container {
    max-width: var(--ancho-maximo);
    margin: 0 auto;
    padding: 0 20px;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-cuerpo);
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--rojo);
  }
  .eyebrow::before {
    content: "";
    width: 18px;
    height: 2px;
    background: var(--rojo);
    display: inline-block;
  }

  /* ============ BLOQUES GENERALES ============ */
  .bloque {
    padding: 44px 0;
    background: var(--secundario);
  }
  .bloque__cabecera {
    max-width: 640px;
    margin: 0 0 30px;
  }
  .bloque__cabecera h2 {
    font-size: clamp(1.5rem, 6vw, 2.1rem);
    font-weight: 600;
    margin-top: 10px;
  }
  .bloque__cabecera p {
    margin-top: 12px;
    color: var(--marron);
    font-size: 1rem;
  }

  /* ============ DIVISOR "PAN PARTIDO" ============ */
  .divisor {
    display: block;
    width: 100%;
    height: 24px;
    margin-top: -1px;
  }
  .divisor--a polygon { fill: var(--crema-oscura); }
  .divisor--b polygon { fill: var(--crema); }
  .divisor--c polygon { fill: var(--marron); }

  /* ============ PRECIOS DETALLADOS (MOBILE-FIRST) ============ */
  .grid-precios {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    align-items: stretch;
  }

  /* Tarjeta Base (Opción Secundaria - Fondo Claro) */
  .precio-tarjeta {
    background: var(--crema-oscura);
    border-radius: var(--radio);
    border: 1px solid var(--crema-linea);
    padding: 26px;
    box-shadow: var(--sombra);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .precio-tarjeta__etiqueta {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--marron);
    background: rgba(0, 0, 0, 0.06);
    padding: 4px 12px;
    border-radius: 999px;
    margin-bottom: 14px;
  }

  .precio-tarjeta__monto {
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 700;
    color: var(--rojo);
    line-height: 1;
  }

  .precio-tarjeta__monto small {
    font-size: 1rem;
    font-weight: 600;
    color: var(--marron);
    display: block;
    margin-top: 6px;
    opacity: 0.85;
  }

  .precio-tarjeta h3 {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 12px 0 8px;
    color: var(--marron);
  }

  .precio-tarjeta p {
    margin: 0;
    color: var(--marron);
    font-size: 0.92rem;
    flex-grow: 1;
  }

  /* Tarjeta Destacada (Hero Card - Fondo Oscuro) */
  .precio-tarjeta--destacada {
    background: var(--marron);
    border: 4px solid var(--rojo);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
  }

  .precio-tarjeta--destacada .precio-tarjeta__etiqueta {
    background: var(--rojo);
    color: #ffffff;
  }

  .precio-tarjeta--destacada .precio-tarjeta__monto,
  .precio-tarjeta--destacada .precio-tarjeta__monto small,
  .precio-tarjeta--destacada p {
    color: var(--secundario);
  }

  
  .precio-tarjeta--destacada h3{
    color:var(--crema-oscura)
  }
 
 
  /* ============ TABLET (min-width 640px) ============ */
  @media (min-width: 640px) {
    .grid-precios {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ============ DESKTOP (min-width 900px) ============ */
  @media (min-width: 900px) {
    .bloque {
      padding: 68px 0;
    }

    .precio-tarjeta--destacada {
      transform: scale(1.03); /* Resalta sutilmente en pantallas grandes */
    }
  }
</style>

<!-- ============ H2: ¿CUÁNTO CUESTA? ============ -->
<section id="precio" class="bloque">
  <div class="container">
    <div class="bloque__cabecera">
      <span class="eyebrow">Precio directo, sin vueltas</span>
      <p>Así de simple: elige la cantidad que necesitas y ya sabes cuánto vas a pagar.</p>
      <h2>{tituloPrecios}</h2>
    </div>

     <div class="grid-precios">
      {tarjetas.map((t, i) => (
  <div class:list={["precio-tarjeta", { "precio-tarjeta--destacada": i === 1 }]}>
    <span class="precio-tarjeta__etiqueta">
      {i === 0 ? "Para pocas unidades" : "Más pedido"}
    </span>
    <div class="precio-tarjeta__monto">{t.monto}<small>{t.unidad}</small></div>
    <h3>{t.titulo}</h3>
    <p>{t.descripcion}</p>
    <a href={t.hrefBoton} class={i === 0 ? "boton boton--secundario" : "boton boton-primario"}>
      {t.textoBoton}
    </a>
  </div>
))}
    </div>
  </div>
</section>

<svg class="divisor divisor--b" viewBox="0 0 1200 30" preserveAspectRatio="none" aria-hidden="true">
  <polygon points="0,12 46,6 92,14 138,22 185,3 231,4 277,19 323,5 369,13 415,20 462,3 508,18 554,8 600,3 646,4 692,15 738,15 785,4 831,9 877,4 923,19 969,15 1015,3 1062,20 1108,5 1154,9 1200,22 1200,30 0,30"/>
</svg>

