---
const today = new Date();
import HeaderLink  from './HeaderLink.astro';
import Cookies from './Cookies.astro'
---
<style>

/* =========================================================
   WHATSAPP
   ========================================================= */
.wa-float{
  position:fixed;
  right:18px;
  bottom:18px;
  z-index:200;
  width:58px;
  height:58px;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:50%;
  background:var(--rojo);
  color:white;
  box-shadow: 0 14px 30px -8px rgba(157,26,4,.65);
  text-decoration:none;
  transition:transform .2s ease;
}

.wa-float:hover{
  transform:scale(1.08);
}

.wa-float svg{
  width:27px;
  height:27px;
}
.contenedor{
  width:100%;
  max-width:1200px;
  margin:0 auto;
  padding:0 20px;
}
.site-footer{
  background:var(--crema-oscura);
  padding:52px 0 0;
  font-size:0.92rem;
  border-top:3px solid var(--rojo);
}
.footer__top{
  display:grid;
  grid-template-columns:1fr;
  gap:34px 28px;
  padding-bottom:36px;
  border-bottom:1px solid var(--rojo);
  align-items:start;
}

/* Columna de marca (logo + nombre + tagline + redes) */
.footer__brand{
  display:flex; flex-direction:column; gap:14px;
}
.footer__logo-row{
  display:flex; align-items:center; gap:10px;
}
.footer__logo-row img{
  width:60px; height:60px; object-fit:contain; border-radius:10px;
  background:var(--rojo);
  padding:2px;
}
.footer__logo-row span{
  font-family:var(--font-cuerpo); font-weight:900; font-size:1.1rem;
  color:var(--rojo);
}
.footer__tagline{
  font-size:0.86rem;
  color:var(--marron);
  max-width:30ch;
}
.footer__social{
  display:flex;
  align-items:center;
  gap:12px;
  margin-top:4px;
}
.footer__social a{
  display:flex; align-items:center; justify-content:center;
  width:36px; height:36px;
  border-radius:50%;
  background:var(--rojo);
  color:var(--crema);
  text-decoration:none;
  transition:background 0.2s ease, color 0.2s ease;
}
.footer__social a svg{width:18px; height:18px;}


/* Encabezado uniforme para TODAS las columnas (mismo nivel) */
.footer__col{
  display:flex; flex-direction:column; gap:14px;
  align-items: center; /* centra iconos + texto */
  justify-content: center;
}


.footer__heading{
  font-family:var(--font-display);
  font-weight:800;
  font-size:0.76rem;
  letter-spacing:0.1em;
  text-transform:uppercase;
  color:var(--rojo);
  line-height:1.2;
  /* misma altura de línea que el logo de la marca, para que todo arranque al mismo nivel */
  min-height:44px;
  display:flex;
  align-items:center;
}

/* Lista de contacto (columna "Contacto") */
.footer__contact-list{
  list-style:none;
  display:flex; flex-direction:column; gap:13px;
}
.footer__contact-list li{
  display:flex; align-items:center; gap:10px;
}
.footer__contact-list .ico{
  flex-shrink:0;
  width:26px; height:26px;
  border-radius:50%;
  background:var(--rojo); /*iconos/svg color de fondo*/
  display:flex; align-items:center; justify-content:center;
  color:aliceblue
}
.footer__contact-list .ico svg{width:14px; height:14px;}
.footer__contact-list a,
.footer__contact-list span{
  text-decoration:none;
  color:var(--marron);
  font-size:0.9rem;
  font-weight: 600;
  transition:color 0.15s ease;
}
.footer__contact-list a:hover{color:var(--rojo); text-decoration:underline;}

/* Listas de enlaces (Productos, Ayuda) */
.footer__links{
  list-style:none;
  display:flex; flex-direction:column; gap:11px;
}
.footer__links a{
  text-decoration:none;
  color:var(--marron);
  font-size:0.9rem;
  font-weight: 600;
  transition:color 0.15s ease;
}
.footer__links a:hover{color:var(--rojo); text-decoration:underline;}

/* Barra inferior */
.footer__bottom{
  display:flex;
  flex-direction:column;
  gap:14px;
  align-items:center;
  padding:20px 0 26px;
  text-align:center;
}
.footer__copy{
  font-size:0.82rem;
  color:var(--rojo);
}

@media (min-width:640px){
  .footer__top{
    grid-template-columns:1fr 1fr;
  }
}
@media (min-width:900px){
  .footer__top{
    grid-template-columns:1.1fr 0.9fr 1fr;
  }
  .footer__logo-row img{
  width:100px; height:100px; 

}
}
@media (min-width:1180px){
  /* Todo en un solo nivel: 5 columnas en una sola fila */
  .footer__top{
    grid-template-columns:1.1fr 0.9fr 1fr 1fr 0.9fr;
    gap:24px;
  }
}
</style>
